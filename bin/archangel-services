#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE=${ARCHANGEL_CONFIG:-/etc/archangel.conf}
STATE_DIR=${ARCHANGEL_STATE_DIR:-/var/lib/archangel}
LIB_DIR=/usr/local/lib/archangel

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    exec sudo env ARCHANGEL_CONFIG="$CONFIG_FILE" ARCHANGEL_STATE_DIR="$STATE_DIR" "$0" "$@"
fi

say() { printf '%s\n' "$*"; }
die() { printf 'archangel-services: %s\n' "$*" >&2; exit 1; }
ask() {
    local prompt=$1 default=$2 value
    if [[ -n "$default" ]]; then
        read -r -p "$prompt [$default]: " value </dev/tty
    else
        read -r -p "$prompt: " value </dev/tty
    fi
    printf '%s' "${value:-$default}"
}
yes_no() {
    local prompt=$1 default=${2:-Y} answer suffix
    [[ "$default" == Y ]] && suffix='Y/n' || suffix='y/N'
    read -r -p "$prompt [$suffix]: " answer </dev/tty
    answer=${answer:-$default}
    [[ "$answer" =~ ^[Yy]$ ]]
}

[[ -r "$CONFIG_FILE" ]] || die "missing $CONFIG_FILE"
# shellcheck disable=SC1090
source "$CONFIG_FILE"
: "${ARCHANGEL_AGENT_USER:?ARCHANGEL_AGENT_USER is not set}"

[[ -r "$LIB_DIR/discovery.sh" ]] || die "missing $LIB_DIR/discovery.sh"
[[ -r "$LIB_DIR/hermes.sh" ]] || die "missing $LIB_DIR/hermes.sh"
# shellcheck disable=SC1090
source "$LIB_DIR/discovery.sh"
# shellcheck disable=SC1090
source "$LIB_DIR/hermes.sh"

ARCHANGEL_HERMES_BIN=$(archangel_hermes_bin || true)
ARCHANGEL_HERMES_HOME="$(archangel_agent_home)/.hermes"

archangel_services_usage() {
    cat <<USAGE
Usage:
  archangel-services status
  archangel-services discover
  archangel-services add URL [TYPE]
  archangel-services apply

  archangel-services gateway status
  archangel-services gateway add NAME ADDRESS [INTERFACE] [TRANSPORT]
  archangel-services gateway service GATEWAY NAME PORT [TYPE] [SCHEME]
  archangel-services gateway probe [NAME]

Gateways are saved endpoint groups, not VPN definitions. Archangel never brings
up or modifies the hinted network interface or transport.
USAGE
}

case "${1:-wizard}" in
    status)
        archangel_services_status
        ;;
    discover|wizard)
        archangel_discovery_wizard
        if yes_no "Apply selected services to Hermes now?" Y; then
            archangel_apply_service_config
        fi
        ;;
    add)
        [[ $# -ge 2 ]] || die "usage: archangel-services add URL [TYPE]"
        url=$(archangel_normalize_url "$2")
        type=${3:-}
        [[ -n "$type" ]] || type=$(archangel_identify_url "$url" || true)
        [[ -n "$type" ]] || type=other
        archangel_record_service "$type" "$url" manual - no yes
        say "Recorded $type at $url"
        ;;
    apply)
        archangel_apply_service_config
        ;;
    gateway)
        subcommand=${2:-status}
        case "$subcommand" in
            status)
                archangel_gateways_status
                ;;
            add)
                [[ $# -ge 4 ]] || die "usage: archangel-services gateway add NAME ADDRESS [INTERFACE] [TRANSPORT]"
                name=$3
                address=$4
                iface=${5:--}
                transport=${6:-auto}
                archangel_record_gateway "$name" "$address" "$iface" "$transport"
                say "Saved gateway '$name' at $address (interface=$iface, transport=$transport)."
                ;;
            service)
                [[ $# -ge 6 ]] || die "usage: archangel-services gateway service GATEWAY NAME PORT [TYPE] [SCHEME]"
                gateway=$3
                service_name=$4
                port=$5
                type=${6:-}
                scheme=${7:-http}
                archangel_gateway_add_service "$gateway" "$service_name" "$port" "$type" "$scheme"
                ;;
            probe)
                archangel_probe_gateway "${3:-}"
                ;;
            *)
                archangel_services_usage
                exit 2
                ;;
        esac
        ;;
    *)
        archangel_services_usage
        exit 2
        ;;
esac
