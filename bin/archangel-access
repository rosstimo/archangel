#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE=${ARCHANGEL_CONFIG:-/etc/archangel.conf}
STATE_DIR=${ARCHANGEL_STATE_DIR:-/var/lib/archangel}
GRANTS_FILE="$STATE_DIR/grants.tsv"
TRAVERSAL_FILE="$STATE_DIR/traversal.tsv"
GRANT_STATE_DIR="$STATE_DIR/grants"
TRAVERSAL_STATE_DIR="$STATE_DIR/traversal"
INSTALL_STATE="$STATE_DIR/install.env"
RECOVERY_DIR=

SELF=$(readlink -f -- "$0")
if [[ -n ${ARCHANGEL_LIB_DIR:-} ]]; then
    LIB_DIR=$ARCHANGEL_LIB_DIR
elif [[ "$SELF" == /usr/local/bin/archangel-access && -d /usr/local/lib/archangel ]]; then
    LIB_DIR=/usr/local/lib/archangel
else
    LIB_DIR=$(cd -- "$(dirname -- "$SELF")/../lib/archangel" && pwd)
fi

# shellcheck source=../lib/archangel/core.sh
source "$LIB_DIR/core.sh"
# shellcheck source=../lib/archangel/acl-snapshots.sh
source "$LIB_DIR/acl-snapshots.sh"
# shellcheck source=../lib/archangel/traversal.sh
source "$LIB_DIR/traversal.sh"
# shellcheck source=../lib/archangel/grants.sh
source "$LIB_DIR/grants.sh"
# shellcheck source=../lib/archangel/commands.sh
source "$LIB_DIR/commands.sh"

main "$@"
